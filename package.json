{
  "name": "@dreamnet/spore-sdk",
  "version": "1.0.0",
  "description": "Public Interoperability Kit & Spore Federation Node Runtime for Independent Agent Civilizations",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BrandonDucar/dreamnet-spore-sdk.git"
  },
  "homepage": "https://github.com/BrandonDucar/dreamnet-spore-sdk#readme",
  "bugs": {
    "url": "https://github.com/BrandonDucar/dreamnet-spore-sdk/issues"
  },
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npx tsx examples/conformance-suite.ts",
    "test:conformance": "npx tsx examples/conformance-suite.ts",
    "test:stream": "npx tsx examples/test-spore-interop.ts"
  },
  "keywords": [
    "dreamnet",
    "spore-sdk",
    "vacuum-spike",
    "proof-drop",
    "interoperability"
  ],
  "author": "DreamNet Open Core Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "canonicalize": "^5.0.0"
  }
}
